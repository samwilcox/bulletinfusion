<div class="uploaderPreviewItem">
    <span class="uploaderDelete"><a href="javascript:void(0);" class="tooltip tooltip--top" data-title="<%= locale.uploaderHelper.deleteFileTooltip %>" data-id="<%= id %>" data-type="<%= type %>" onclick="deleteFile(this);"><i class="fa-solid fa-trash-can"></i></a></span>
    <div class="uploaderPreviewItemFileName"><%= fileName %></div>
    <div class="uploaderPreviewItemPhoto"><i class="fa-solid fa-file"></i></div>
    <div class="uploaderPreviewItemSize"><%- fileSize %></div>
</div>