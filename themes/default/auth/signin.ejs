<form name="signinform" id="signinform" action="<%= action %>" method="post" enctype="application/x-www-form-urlencoded">
    <div class="signInBox">
        <div class="signInBoxHeader"><%= locale.auth.signInTitle %></div>
        <div class="signInBoxContent">
            <%- errorBox %>
            <div class="formGroup">
                <% if (signInWithUsername) { %>
                    <input type="text" name="identity" id="identity-input" placeholder="<%= locale.auth.usernameEmailPlaceholder %>">
                    <label for="identity-input"><%= locale.auth.usernameEmailPlaceholder %></label>
                <% } else { %>
                    <input type="email" name="identity" id="identity-input" placeholder="<%= locale.auth.emailPlaceholder %>">
                    <label for="identity-input"><%= locale.auth.emailPlaceholder %></label>
                <% } %>
            </div>
            <div class="formGroup relative">
                <span class="passwordToggle"><a href="javascript:void(0);" class="tooltip tooltip--top" data-title="Toggle password display" data-field="password-input" data-icon="password-toggle-icon" onclick="togglePassword(this);"><i class="fa-solid fa-eye" id="password-toggle-icon"></i></a></span>
                <input type="password" name="password" id="password-input" placeholder="<%= locale.auth.passwordPlaceholder %>" class="passwordField">
                <label for="identity-input"><%= locale.auth.passwordPlaceholder %></label>
            </div>
            <div class="fieldsGrid">
                <div class="forgotPassword"><a href="<%= forgotPasswordUrl %>"><%= locale.auth.forgotPasswordUrl %></a></div>
                <div>
                    <div class="checkboxGrid">
                        <div>
                            <div class="checkbox">
                                <span class="checkbox">
                                    <input type="checkbox" name="rememberme" id="rememberme-checkbox"<% if (settings.signInRememberMeChecked) { %> checked<% } %>>
                                    <svg>
                                    <use xlink:href="#checkbox" class="checkbox"></use>
                                    </svg>
                                </span>
                                <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
                                    <symbol id="checkbox" viewBox="0 0 22 22">
                                    <path fill="none" stroke="currentColor" d="M5.5,11.3L9,14.8L20.2,3.3l0,0c-0.5-1-1.5-1.8-2.7-1.8h-13c-1.7,0-3,1.3-3,3v13c0,1.7,1.3,3,3,3h13 c1.7,0,3-1.3,3-3v-13c0-0.4-0.1-0.8-0.3-1.2"/>
                                    </symbol>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <label for="rememberme-checkbox">
                                <span class="checkboxTitle"><%= locale.auth.rememberMeTitle %></span><br>
                                <span class="checkboxInfo"><%= locale.auth.rememberMeInfo %></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="signInBoxFooter">
            <% if (settings.csrfEnabled) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <input type="hidden" name="referer" value="<%= referer %>">
            <input type="submit" name="signinformsubmit" value="<%= locale.auth.signInButton %>">
        </div>
    </div>
    <% if (oauth.enabled) { %>
        <div class="signInFloater">
            <div class="lineText"><%= locale.auth.orSignInProvider %></div>
            <div class="signInOauth">
                <% if (oauth.facebook) { %>
                    <a href="<%= oauth.facebookUrl %>" class="tooltip tooltip--top" data-title="<%= locale.auth.facebookTooltip %>"><i class="fa-brands fa-square-facebook"></i></a>
                <% } %>
                <% if (oauth.google) { %>
                    <a href="<%= oauth.googleUrl %>" class="tooltip tooltip--top" data-title="<%= locale.auth.googleTooltip %>"><i class="fa-brands fa-google"></i></a>
                <% } %>
                <% if (oauth.bluesky) { %>
                    <a href="<%= oauth.blueskyUrl %>" class="tooltip tooltip--top" data-title="<%= locale.auth.blueskyTooltip %>"><i class="fa-brands fa-bluesky"></i></a>
                <% } %>
            </div>
        </div>
    <% } %>
</form>