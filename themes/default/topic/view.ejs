<div class="pageBannerTop">
    <span class="forumsSymbolLinkTopic"><a href="<%= forum.url() %>" style="color: <%= forum.getTextColor() %>; background-color: <%= forum.getColor() %>" onmouseover="this.style.color='<%= forum.getDarkColor().idealTextColor %>'; this.style.backgroundColor='<%= forum.getDarkColor().darkenedColor %>';" onmouseout="this.style.color='<%= forum.getTextColor() %>'; this.style.backgroundColor='<%= forum.getColor() %>';"><%- forum.getIcon() %><%= forum.getTitle() %></a></span>
    <div class="dualGridCentered">
        <div class="title">
            <% if (tags) { %>
                <div class="dualRowGrid">
                    <div><%= topic.getTitle() %></div>
                    <div class="tagsSmallLink">tags</div>
                </div>
            <% } else { %>
                <%= topic.getTitle() %>
            <% } %>
        </div>
        <div class="alignRight buttonsGroup">
            <% if (permissions.reply) { %>
                <span class="brightButton"><a href="javascript:void(0);"><i class="fa-solid fa-reply"></i>Reply</a></span>
            <% } %>
            <% if (permissions.newTopic) { %>
                <span class="brightButton"><a href=""><i class="fa-solid fa-folder-plus"></i>New Topic</a></span>
            <% } %>
        </div>
    </div>
</div>
<div class="pageBannerBottom">
    <div class="dualGridCentered">
        <div>
            <div class="sideBySideGrid blockAlignLeft">
                <div><%- topicAuthorPhoto %></div>
                <div>
                    <div class="sideBySideRowGrid">
                        <div><%- topicBy %></div>
                        <div class="dimmedText"><%- topicCreated %></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="alignRight">
            <script>
                $(document).ready(function() {
                    getSubscribeButton(<%= contentId %>, '<%= contentType %>');
                });
            </script>
            <span id="subscribe-button"></span>
        </div>
    </div>
</div>