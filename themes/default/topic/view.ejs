<script>
    var posts = {
        enabled: true,
        topicId: <%= topic.getId() %>,
        currentPage: <%= currentPage %>,
    };

    var paginationMode = 'posts';
    var paginationTopId = 'pagination-bar-<%= topUuid %>';
    var paginationBottomId = 'pagination-bar-<%= bottomUuid %>'
    var addressBarUrl = '<%= pageUrl %>';
</script>
<div class="pageBannerTop">
    <span class="forumsSymbolLinkTopic"><a href="<%= forum.url() %>" style="color: <%= forum.getTextColor() %>; background-color: <%= forum.getColor() %>" onmouseover="this.style.color='<%= forum.getDarkColor().idealTextColor %>'; this.style.backgroundColor='<%= forum.getDarkColor().darkenedColor %>';" onmouseout="this.style.color='<%= forum.getTextColor() %>'; this.style.backgroundColor='<%= forum.getColor() %>';"><%- forum.getIcon() %><%= forum.getTitle() %></a></span>
    <div class="dualGridCentered">
        <div class="title">
            <% if (tags && tags.length > 0) { %>
                <div class="dualRowGrid">
                    <div><%= topic.getTitle() %></div>
                    <div class="tagsSmallLink"><span class="tooltip tooltip--top" data-title="<%= locale.topic.tagsTooltip %>"><i class="fa-solid fa-tags"></i><i class="fa-solid fa-arrow-right"></i></span><%- tags %></div>
                </div>
            <% } else { %>
                <%= topic.getTitle() %>
            <% } %>
        </div>
        <div class="alignRight buttonsGroup">
            <% if (permissions.reply && !pollData.pollOnly) { %>
                <span class="brightButton"><a href="javascript:void(0);" data-editor="editor-<%= editorId %>" onclick="openQuickReply(this);"><i class="fa-solid fa-reply"></i>Reply</a></span>
            <% } %>
            <% if (permissions.newTopic) { %>
                <span class="brightButton"><a href=""><i class="fa-solid fa-folder-plus"></i>New Topic</a></span>
            <% } %>
        </div>
    </div>
</div>
<div class="pageBannerBottom">
    <div class="dualGridCentered">
        <div>
            <div class="sideBySideGrid blockAlignLeft">
                <div><%- topicAuthorPhoto %></div>
                <div>
                    <div class="sideBySideRowGrid">
                        <div><%- topicBy %></div>
                        <div class="dimmedText"><%- topicCreated %></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="alignRight">
            <script>
                $(document).ready(function() {
                    getSubscribeButton(<%= contentId %>, '<%= contentType %>');
                });
            </script>
            <span id="subscribe-button"></span>
        </div>
    </div>
</div>
<% if (pollData.hasPoll) { %>
    <%- pollData.pollHtml %>
<% } %>
<span id="pagination-top-bar"><%- paginationTop %></span>
<div id="posts-container"></div>
<div class="loadingContent" id="content-loading">
    <div class="loadingContentGrid">
        <div><img src="<%= imagesetUrl %>/images/loaders/pulse-loader.gif" alt="*"></div>
        <div id="content-loading-content"></div>
    </div>
</div>
<span id="pagination-bottom-bar"><%- paginationBottom %></span>
<% if (previousAndNext.previous && previousAndNext.next) { %>
    <div class="nextPreviousTopicBar">
        <div class="left">
            <% if (previousAndNext.left) { %>
                <a href="<%= previousAndNext.left.url() %>"><i class="fa-solid fa-arrow-left"></i><%= locale.topic.previousTopic %></a>
            <% } %>
        </div>
        <div class="alignRight right">
            <% if (previousAndNext.right) { %>
                <a href="<%= previousAndNext.right.url() %>"><%= locale.topic.nextTopic %><i class="fa-solid fa-arrow-right"></i></a>
            <% } %>
        </div>
    </div>
<% } %>
<% if (quickReply) { %>
    <%- quickReply %>
<% } %>
<% if (similarTopics) { %>
    <%- similarTopics %>
<% } %>