<div class="attachmentItem">
    <div class="attachmentItemGrid">
        <div class="attachmentItemGridTop"><%= fileName %></div>
        <div class="attachmentItemGridCenter">
            <div class="attachmentItemGridCenterGrid">
                <div class="attachmentItemGridCenterGridLeft"><%- fileSize %></div>
                <div class="attachmentItemGridCenterGridRight"><%- downloads %></div>
            </div>
        </div>
        <div class="attachmentItemGridBottom"><a href="<%= downloadUrl %>"><%= locale.attachmentEntity.downloadLink %></a></div>
    </div>
</div>